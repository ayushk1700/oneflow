+.links-grid .link-icon,.links-list .link-icon { font-size:var(--link-icon-size); }
+.personal-row input { max-width:100%; }
+
+[data-link-view=list] { display:grid!important; gap:var(--space-xs); }
+[data-link-view=list] .quick-link { display:flex; align-items:center; gap:var(--space-sm); }
+.link-monogram { font-size:var(--link-icon-size,var(--text-body)); }
+.personal-task-add { display:flex; gap:var(--space-sm); margin-bottom:var(--space-md); }
+.personal-task-board { display:grid; gap:var(--space-sm); }
+[data-view=kanban] .personal-task-board { grid-template-columns:repeat(3,minmax(0,1fr)); }
+[data-view=matrix] .personal-task-board { grid-template-columns:repeat(2,minmax(0,1fr)); }
+.personal-task-column { display:grid; align-content:start; gap:var(--space-sm); padding:var(--space-sm); border:var(--stroke) solid var(--border); border-radius:var(--radius-control); }
+.personal-task-card { display:flex; flex-wrap:wrap; align-items:center; gap:var(--space-xs); padding:var(--space-sm); background:var(--panel); border-radius:var(--radius-small); }
+.personal-task-card small { width:100%; color:var(--muted); }
+.journal-markdown { padding:var(--space-lg); border-top:var(--stroke) solid var(--border); color:var(--text); }
+@media(max-width:700px){[data-view=kanban] .personal-task-board,[data-view=matrix] .personal-task-board { grid-template-columns:1fr; }}
+
+.personal-task-views[data-completed=true] { animation:personal-task-complete var(--motion-base) var(--easing-standard); }
+@keyframes personal-task-complete { from { opacity:var(--completion-start-opacity); } to { opacity:1; } }
+
+.space-switcher select { max-width:var(--space-switcher-width); }
+
+.layout-node { --canvas-ink:var(--text); --canvas-muted:var(--muted); --canvas-line:var(--border); --canvas-control:var(--panel); }
+
+.space-switcher select { color:var(--canvas-ink); }
+.space-switcher option { color:var(--text); background:var(--panel); }
+
+.workspace .personal-task-views { --panel:var(--notes-card); --text:var(--notes-ink); --muted:var(--notes-muted); --border:var(--notes-line); color:var(--notes-ink); }
+.workspace .markdown-preview { color:var(--notes-ink); }
+html[data-motion=reduce] .personal-task-views { animation:none!important; }
+
+.clock-glyph { position:relative; display:inline-flex; align-items:center; justify-content:center; min-width:1ch; }
+.clock-glyph::after { content:""; position:absolute; top:50%; inset-inline:0; height:var(--stroke); background:var(--canvas-line); }
+
+.layout-node { background:color-mix(in srgb,var(--panel) calc(var(--widget-opacity) * var(--panel-alpha) * 100%),transparent); box-shadow:var(--elevation-popover); }
+html[data-theme=light] .layout-node { --muted:var(--text); }
